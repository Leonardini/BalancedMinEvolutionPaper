# Theory and enumeration: the facets of P_6, the clique covers, the sufficiency theorem and
# the splitohedron. One thread each.
# Longest first, so they start first.

# The computer-assisted proof of the sufficiency theorem, table "Canonical survivors of the enumeration": canonical survivors, none violating (10).
experiments/theory/theorem5.sh canon_n11 11
experiments/theory/theorem5.sh canon_n10 10
# Appendix D (ii): cherry fixed at {1,2}, violation fixed at {1,2,3,4}: 84 witnesses, one class.
experiments/theory/theorem5.sh fpviol_n12_t2 12 --fpviol --t01 2
# The facets of P_6.
Rscript experiments/theory/p6_facets.R "$RESULTS/p6_facets"
# Appendix J: the vertices of the splitohedron.
Rscript experiments/theory/splitohedron.R 6 "$RESULTS/splitohedron"
Rscript experiments/theory/splitohedron.R 5 "$RESULTS/splitohedron"
# "Incompatibility and a polynomial clique cover" and appendix "Clique covers of the crossing graph": clique covers (the minimum up to n = 7, the fractional minimum up
# to n = 8), and the random-objective LPs over the cover of the polynomial-laminarity proposition.
"$PY" experiments/theory/clique_cover.py 8 "$RESULTS/clique_cover/n8.json" --no-ilp
"$PY" experiments/theory/clique_cover.py 7 "$RESULTS/clique_cover/n7.json"
"$PY" experiments/theory/clique_cover.py 6 "$RESULTS/clique_cover/n6.json"
"$PY" experiments/theory/clique_cover.py 5 "$RESULTS/clique_cover/n5.json"
"$PY" experiments/theory/clique_cover.py 4 "$RESULTS/clique_cover/n4.json"
"$PY" experiments/theory/clique_integrality.py "$RESULTS/clique_cover/integrality.json" 300 12345
# Table "Canonical survivors of the enumeration", smaller n.
experiments/theory/theorem5.sh canon_n9 9
experiments/theory/theorem5.sh canon_n8 8
experiments/theory/theorem5.sh canon_n7 7
experiments/theory/theorem5.sh canon_n6 6
experiments/theory/theorem5.sh canon_n5 5
# Appendix D: without the ordering on leaf 1's row, survivors = (2n-5)!!.
experiments/theory/theorem5.sh full_n8 8 --full
experiments/theory/theorem5.sh full_n7 7 --full
experiments/theory/theorem5.sh full_n6 6 --full
experiments/theory/theorem5.sh full_n5 5 --full
# Appendix D (i): at n = 12 every matrix satisfying (4)-(9) has a cherry (needed in (ii)).
experiments/theory/theorem5.sh nocherry_n12 12 --nocherry
# Appendix D (iii): weak-triangle 6-node matrices: 285 = 105 + 180, one S_6 orbit, stabiliser 4.
experiments/theory/theorem5.sh weak_n6 6 --weak --full
# "Sufficiency of the path-length conditions": the cherry lift satisfies (4)-(9) and violates (10) on 216 quartets.
"$PY" experiments/theory/cherry_lift.py "$RESULTS/theorem5/cherry_lift.json"
# "Sufficiency of the path-length conditions": the matrix of Catanzaro et al. (2026, p. 492) is a relabelling of it.
"$PY" experiments/theory/catanzaro_p492.py data/theory/catanzaro2026_p492.txt "$RESULTS/theorem5/catanzaro_p492.json"
